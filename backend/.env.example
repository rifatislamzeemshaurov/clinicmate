# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored — never commit real keys.

# Required: OpenAI API key (also passed to AWS by the deploy scripts)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI chat model (used locally and injected into the ECS task by Terraform)
OPENAI_MODEL=gpt-4o-mini

# Local development only
CORS_ORIGINS=http://localhost:3000
USE_S3=false
S3_BUCKET=
MEMORY_DIR=../memory
